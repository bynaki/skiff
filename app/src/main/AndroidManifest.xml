<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Android 17 gates private-range addresses behind their own runtime permission: with only
      INTERNET, a connection to 192.168.x.x is dropped and surfaces as a socket timeout rather
      than a refusal. Almost every server this app talks to is on the local network.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Guards ProfileProvider. Skiff Code declares the same permission, so it is granted whichever
      app is installed first, and only when both are signed with the same key.
    -->
    <permission
        android:name="com.naki.skiff.permission.READ_PROFILES"
        android:protectionLevel="signature" />

    <!-- openInSkiffCode compares Skiff Code's signature with ours before sending it a link. -->
    <queries>
        <package android:name="com.naki.skiff.code" />
    </queries>

    <application
        android:name=".SkiffApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Skiff">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:theme="@style/Theme.Skiff">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".transfer.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".data.ProfileProvider"
            android:authorities="com.naki.skiff.profiles"
            android:exported="true"
            android:permission="com.naki.skiff.permission.READ_PROFILES" />
    </application>
</manifest>
