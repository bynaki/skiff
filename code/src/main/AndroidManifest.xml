<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 drops, rather than refuses, connections to private-range addresses without it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- skiffcode:///path from Skiff names a local file by its path; docs/skiffcode.spec.md, decision 5. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
      Skiff's profile provider. Declared here as well as in Skiff so it is granted whichever app is
      installed first; signature level, so only when both are signed with the same key.
    -->
    <permission
        android:name="com.naki.skiff.permission.READ_PROFILES"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.naki.skiff.permission.READ_PROFILES" />

    <queries>
        <provider android:authorities="com.naki.skiff.profiles" />
    </queries>

    <application
        android:name=".SkiffCodeApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Skiff Code"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!--
          singleTask: a second link goes to the running instance's onNewIntent, where the open
          files live, instead of stacking another editor into the calling app's task.
          configChanges: a rotation or fold must not recreate the activity and cancel an open
          that is waiting on a dialog. `keyboard` and `navigation` are in the list for the same
          reason: connecting a keyboard moves both. Measured on the tablet with a Bluetooth
          keyboard, `am get-config` went from `keysexposed-nokeys-navhidden-nonav` to
          `keysexposed-qwerty-navexposed-dpad` — the keyboard reports a d-pad as well, so leaving
          `navigation` out recreated the activity every time it was switched on.
          The recreation itself is survivable either way, since onCreate carries the open document
          over (onRetainNonConfigurationInstance); this only spares the WebView and the reparse.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="skiffcode" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
